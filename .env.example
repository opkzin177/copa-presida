# Copie para variáveis de ambiente no Netlify
# Site settings → Environment variables → Add a variable
# Marque como "Secret" as que tiverem senha/token.

# ── InfinitePay (recomendado — Pix taxa zero) ──────────────────────────────
# Sua InfiniteTag (sem o $). Exemplo: se no app aparece $minhatag → minhatag
INFINITEPAY_HANDLE=sua_infinite_tag

# Opcional: segredo para validar webhook (recomendado em produção)
# INFINITEPAY_WEBHOOK_SECRET=um-segredo-longo-aleatorio

# ── PagBank (legado / opcional) ────────────────────────────────────────────
# PAGBANK_TOKEN=seu_token_aqui
# PAGBANK_ENV=sandbox
# PAGBANK_WEBHOOK_SECRET=segredo-aleatorio

# ── Site ───────────────────────────────────────────────────────────────────
SITE_URL=https://inscricaocopapresida.com

# ── Admin da área restrita (OBRIGATÓRIO em produção) ────────────────────────
ADMIN_USER=admincopa
ADMIN_PASS=troque-esta-senha-por-uma-forte-de-16-chars

# ── Firebase (default já no código) ────────────────────────────────────────
# FIREBASE_DB_URL=https://copa-presida-default-rtdb.firebaseio.com/presida_v2.json
