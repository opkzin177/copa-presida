# Copie para variáveis de ambiente no Netlify (Site settings → Environment variables)

# PagBank API (opcional — sem isso o site usa os links estáticos pag.ae)
PAGBANK_TOKEN=seu_token_aqui
PAGBANK_ENV=sandbox
# ou production

# Webhook PagBank (opcional)
# PAGBANK_WEBHOOK_SECRET=segredo-aleatorio
# SITE_URL=https://inscricaocopapresida.com

# Admin da área restrita
ADMIN_USER=copa5
ADMIN_PASS=troque-esta-senha-forte

# Firebase (default já no código)
# FIREBASE_DB_URL=https://copa-presida-default-rtdb.firebaseio.com/presida_v2.json
